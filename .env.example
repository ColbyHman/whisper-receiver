# Webhook URL to send transcription results to (required)
# This is your destination URL that will receive the transcribed text
WEBHOOK_URL=http://localhost:8080/webhook

# Whisper model to use (default: ggml-medium-q5_0)
# Available models: https://huggingface.co/ggerganov/whisper.cpp
WHISPER_MODEL=ggml-medium-q5_0